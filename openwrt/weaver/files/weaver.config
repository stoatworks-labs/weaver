# weaver: bond this router's WANs into one tunnel. See docs/OPENWRT.md.
#
# /etc/init.d/weaver turns this file into /var/run/weaver/weaver.json.
# Durations are milliseconds; rates are kbit/s.

config weaver 'main'
	option enabled '0'
	# client: has the WANs and connects to a server.
	# server: listens on listen_port; clients are 'peer' sections below.
	option role 'client'
	# Filled in on install (weaver genkey). Never share it.
	option private_key ''
	# server only
	option listen_port '9328'
	# client only: host:port of the server and its public key
	option server ''
	option server_public_key ''
	# Tunnel address on weaver0. A server defaults to 10.77.0.1/24 when
	# this is unset.
	option address '10.77.0.2/24'
	option mtu '1380'
	# adaptive | bond | redundant | failover
	option mode 'adaptive'
	# client: also use every up interface with an IPv4 default route that
	# has no 'path' section, as a primary path.
	option auto_paths '1'
	# client: route everything (0.0.0.0/1 + 128.0.0.0/1) through the tunnel...
	option default_route '1'
	# ...and/or only these subnets.
	#list subnet '10.10.0.0/16'
	# client: when every path has been down for 5 s, route the LAN directly
	# to the internet until the tunnel is back.
	option fallback_direct '1'
	option probe_interval '200'
	option path_timeout '1000'
	# debug | info | warn | error
	option log_level 'info'

# Paths (client). Without any, auto_paths finds the WANs. A section pins an
# interface's priority, gives rate hints, or (priority 'disabled') keeps
# auto_paths off it. 'interface' is the netifd interface name (Network ->
# Interfaces), not the device.
#
# priority: primary   always used
#           secondary used for overflow, once the primaries are 50 ms busy
#           backup    carries nothing while a primary or secondary is up
#           disabled  never used
# up_kbps/down_kbps: the link's speed if known (0 = learn it).
# metered: probe less often when idle.

#config path
#	option interface 'wan'
#	option priority 'primary'

#config path
#	option interface 'wwan'
#	option priority 'primary'

#config path
#	option interface 'tethering'
#	option priority 'secondary'
#	option metered '1'

#config path
#	option interface 'modem'
#	option priority 'backup'
#	option up_kbps '5000'
#	option down_kbps '20000'
#	option metered '1'

# Peers (server): one per client router. 'address' is the client's tunnel
# address; allowed_ip lists the client-side subnets the server may route to
# it (its LAN, if the client does not masquerade).

#config peer
#	option name 'flint'
#	option public_key 'client public key (base64)'
#	option address '10.77.0.2'
#	list allowed_ip '192.168.8.0/24'
