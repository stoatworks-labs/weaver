#!/bin/sh /etc/rc.common
# shellcheck shell=ash
# shellcheck disable=SC2034 # USE_PROCD, START and STOP are read by rc.common
#
# weaver: bond this router's WANs into one tunnel.
#
# Turns /etc/config/weaver into /var/run/weaver/weaver.json (the schema in
# docs/DESIGN.md) and runs `weaver run -c` under procd. `reload` regenerates
# the file and sends SIGHUP, unless something that needs a restart changed (see
# restart.key below), in which case procd restarts the daemon itself.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/weaver
RUN_DIR=/var/run/weaver
CONF_JSON=$RUN_DIR/weaver.json
# Digest of the settings the daemon can't apply on SIGHUP (config.NeedsRestart:
# key, role, port, server, TUN, control socket, peers, routing). procd hashes
# this file (procd_set_param file) and restarts the instance when it changes,
# so a SIGHUP is only sent when the daemon can take the change in place.
RESTART_KEY=$RUN_DIR/restart.key
TUN_NAME=weaver0
FW_RULE=Allow-Weaver

extra_command "genconf" "Write $CONF_JSON from UCI (even if disabled) and print its path"
extra_command "closefw" "Disable the $FW_RULE firewall rule (the package's prerm runs this)"

# Set by weaver_generate.
W_OPEN=0
W_PORT=9328
W_KNOWN_IFACES=""
W_KNOWN_DEVS=""
W_EXCLUDE=""
W_NPATHS=0
W_RKEY=""

log() {
	logger -t weaver -p "daemon.$1" "$2"
	[ "$1" = err ] && echo "weaver: $2" >&2
	return 0
}

is_uint() {
	case "$1" in
	'' | *[!0-9]*) return 1 ;;
	esac
	return 0
}

list_has() {
	case " $1 " in
	*" $2 "*) return 0 ;;
	esac
	return 1
}

# uint_get VAR SECTION OPTION DEFAULT: an integer option. Hex (0x...) is
# accepted, anything else that isn't a number falls back to DEFAULT.
uint_get() {
	local __v
	config_get __v "$2" "$3"
	case "$__v" in
	0[xX]*)
		# Checked first: a bad arithmetic expansion would end the script.
		case "${__v#0[xX]}" in
		'' | *[!0-9a-fA-F]*) ;;
		*) __v=$((__v)) ;;
		esac
		;;
	esac
	if [ -n "$__v" ] && ! is_uint "$__v"; then
		log warn "$2.$3: '$__v' is not a number, using '$4'"
		__v=""
	fi
	[ -n "$__v" ] || __v=$4
	eval "$1=\$__v"
}

# json_opt_int SECTION OPTION KEY: add KEY only when OPTION is set, so the
# daemon's own default applies otherwise.
json_opt_int() {
	local v
	uint_get v "$1" "$2" ""
	[ -n "$v" ] && json_add_int "$3" "$v"
	return 0
}

json_str_item() {
	json_add_string "" "$1"
}

# The same, for lists that need a restart when they change.
json_rkey_item() {
	json_add_string "" "$1"
	W_RKEY="$W_RKEY,$1"
}

json_path() { # name device priority up_kbps down_kbps metered
	json_add_object
	json_add_string name "$1"
	json_add_string device "$2"
	json_add_string priority "$3"
	json_add_int up_kbps "$4"
	json_add_int down_kbps "$5"
	json_add_boolean metered "$6"
	json_close_object
	W_NPATHS=$((W_NPATHS + 1))
}

# One 'path' section: resolve its netifd interface to the L3 device.
weaver_path() {
	local sid="$1" iface priority up down metered dev=""

	config_get iface "$sid" interface
	[ -n "$iface" ] || {
		log warn "path $sid has no interface, ignored"
		return 0
	}
	W_KNOWN_IFACES="$W_KNOWN_IFACES $iface"
	config_get priority "$sid" priority primary

	if [ "$priority" = disabled ]; then
		# Keep the daemon's own auto-detection off it too.
		network_get_device dev "$iface" || network_get_physdev dev "$iface"
		[ -n "$dev" ] && W_EXCLUDE="$W_EXCLUDE $dev"
		return 0
	fi
	case "$priority" in
	primary | secondary | backup) ;;
	*)
		log warn "path $iface: unknown priority '$priority', using primary"
		priority=primary
		;;
	esac

	network_is_up "$iface" || {
		log info "path $iface: interface is down, skipped until it comes up"
		return 0
	}
	network_get_device dev "$iface" || {
		log warn "path $iface: no L3 device, skipped"
		return 0
	}
	list_has "$W_KNOWN_DEVS" "$dev" && return 0
	W_KNOWN_DEVS="$W_KNOWN_DEVS $dev"

	uint_get up "$sid" up_kbps 0
	uint_get down "$sid" down_kbps 0
	config_get_bool metered "$sid" metered 0
	json_path "$iface" "$dev" "$priority" "$up" "$down" "$metered"
}

# Every up interface with an IPv4 default route (in any table) and no 'path'
# section becomes a primary path. VPN interfaces never do: their devices go
# on exclude_devices so the daemon's own auto-detection skips them as well.
weaver_auto_paths() {
	local dump iface up dev proto route

	dump=$(ubus call network.interface dump 2>/dev/null) || return 0
	for iface in $(jsonfilter -s "$dump" -e '@.interface[*].interface' 2>/dev/null); do
		case "$iface" in
		weaver | loopback) continue ;;
		esac
		up=$(jsonfilter -s "$dump" -e "@.interface[@.interface='$iface'].up")
		[ "$up" = true ] || continue
		dev=$(jsonfilter -s "$dump" -e "@.interface[@.interface='$iface'].l3_device")
		if [ -z "$dev" ] || [ "$dev" = "$TUN_NAME" ]; then
			continue
		fi
		proto=$(jsonfilter -s "$dump" -e "@.interface[@.interface='$iface'].proto")
		case "$proto" in
		wireguard | wg* | openvpn | ovpn* | vpnc | zerotier | tailscale | \
			gre* | ipip | vti* | xfrm | 6in4 | 6to4 | 6rd | dslite | map | relay)
			list_has "$W_EXCLUDE" "$dev" || W_EXCLUDE="$W_EXCLUDE $dev"
			continue
			;;
		esac
		list_has "$W_KNOWN_IFACES" "$iface" && continue
		list_has "$W_KNOWN_DEVS" "$dev" && continue
		list_has "$W_EXCLUDE" "$dev" && continue
		route=$(jsonfilter -s "$dump" \
			-e "@.interface[@.interface='$iface'].route[@.target='0.0.0.0' && @.mask=0].target")
		[ -n "$route" ] || continue

		W_KNOWN_DEVS="$W_KNOWN_DEVS $dev"
		json_path "$iface" "$dev" primary 0 0 0
	done
}

weaver_peer() {
	local sid="$1" name pub addr

	config_get name "$sid" name "$sid"
	config_get pub "$sid" public_key
	config_get addr "$sid" address
	# The daemon refuses the whole file over one incomplete peer, so leave
	# it out instead.
	if [ -z "$pub" ] || [ -z "$addr" ]; then
		log warn "peer $name needs both public_key and address; ignored"
		return 0
	fi

	W_RKEY="$W_RKEY
peer $name $pub $addr"
	json_add_object
	json_add_string name "$name"
	json_add_string public_key "$pub"
	json_add_string address "$addr"
	json_add_array allowed_ips
	config_list_foreach "$sid" allowed_ip json_rkey_item
	json_close_array
	json_close_object
}

# weaver_generate [force]: write CONF_JSON and RESTART_KEY.
# Returns 0 when written, 1 on a config error, 2 when disabled (and not
# forced), 3 when a client has auto_paths off and none of its paths is up
# (the hotplug script starts it once one is). Sets W_OPEN (firewall rule
# wanted) and W_PORT either way.
weaver_generate() {
	local force="$1" enabled role key port server spub addr mtu mode loglevel
	local auto defroute fallback policy probe ptimeout sock dev

	config_load weaver
	config_get_bool enabled main enabled 0
	config_get role main role client
	uint_get port main listen_port 9328
	W_PORT=$port
	W_OPEN=0
	[ "$enabled" = 1 ] && [ "$role" = server ] && W_OPEN=1

	case "$role" in
	client | server) ;;
	*)
		log err "weaver.main.role is '$role', not client or server"
		return 1
		;;
	esac
	[ "$enabled" = 1 ] || [ "$force" = force ] || return 2

	config_get key main private_key
	[ -n "$key" ] || {
		log err "weaver.main.private_key is empty; set one with: uci set weaver.main.private_key=\"\$(weaver genkey)\"; uci commit weaver"
		return 1
	}
	config_get server main server
	config_get spub main server_public_key
	if [ "$role" = client ]; then
		[ -n "$server" ] || {
			log err "client role needs weaver.main.server (host:port)"
			return 1
		}
		[ -n "$spub" ] || {
			log err "client role needs weaver.main.server_public_key"
			return 1
		}
	fi

	config_get addr main address
	if [ -z "$addr" ]; then
		addr=10.77.0.2/24
		[ "$role" = server ] && addr=10.77.0.1/24
	fi
	uint_get mtu main mtu 1380
	config_get mode main mode adaptive
	case "$mode" in
	adaptive | bond | redundant | failover) ;;
	*)
		log warn "unknown mode '$mode', using adaptive"
		mode=adaptive
		;;
	esac
	config_get_bool auto main auto_paths 1
	config_get_bool defroute main default_route 1
	config_get_bool fallback main fallback_direct 1
	config_get_bool policy main policy_routing 1
	uint_get probe main probe_interval 200
	uint_get ptimeout main path_timeout 1000
	config_get sock main control_socket /var/run/weaver.sock
	config_get loglevel main log_level info

	W_NPATHS=0
	W_RKEY="$role $key $port $server $spub $TUN_NAME $mtu $addr $sock"
	json_init
	json_add_string role "$role"
	json_add_string private_key "$key"
	json_add_object tun
	json_add_string name "$TUN_NAME"
	json_add_int mtu "$mtu"
	json_add_string address "$addr"
	json_close_object
	json_add_string mode "$mode"

	if [ "$role" = server ]; then
		json_add_int listen_port "$port"
		json_add_array peers
		config_foreach weaver_peer peer
		json_close_array
	else
		json_add_string server "$server"
		json_add_string server_public_key "$spub"
		json_add_boolean auto_paths "$auto"

		W_KNOWN_IFACES=""
		W_KNOWN_DEVS=""
		W_EXCLUDE=""
		network_get_device dev lan && W_EXCLUDE="$dev"
		config_list_foreach main exclude_device weaver_exclude
		json_add_array paths
		config_foreach weaver_path path
		[ "$auto" = 1 ] && weaver_auto_paths
		json_close_array
		json_add_array exclude_devices
		for dev in $W_EXCLUDE; do
			json_add_string "" "$dev"
		done
		json_close_array

		json_add_object routing
		json_add_boolean default_route "$defroute"
		json_add_array subnets
		config_list_foreach main subnet json_rkey_item
		json_close_array
		json_add_boolean fallback_direct "$fallback"
		json_add_boolean policy_routing "$policy"
		json_opt_int main fwmark_base fwmark_base
		json_opt_int main table_base table_base
		json_opt_int main rule_priority rule_priority
		json_close_object
		W_RKEY="$W_RKEY
routing $defroute $fallback $policy $(uci -q get weaver.main.fwmark_base) $(uci -q get weaver.main.table_base) $(uci -q get weaver.main.rule_priority)"

		if [ "$auto" != 1 ] && [ "$W_NPATHS" = 0 ] && [ "$force" != force ]; then
			log info "no path is up and auto_paths is off; waiting for an interface"
			return 3
		fi
	fi

	json_add_int probe_interval_ms "$probe"
	json_opt_int main idle_probe_interval idle_probe_interval_ms
	json_add_int path_timeout_ms "$ptimeout"
	json_opt_int main reorder_timeout reorder_timeout_ms
	json_opt_int main realtime_kbps realtime_kbps
	json_opt_int main rekey_interval rekey_interval_s
	json_add_string control_socket "$sock"
	json_add_string log_level "$loglevel"

	mkdir -p "$RUN_DIR"
	chmod 0700 "$RUN_DIR"
	(
		umask 077
		json_dump -i >"$CONF_JSON.$$" &&
			mv -f "$CONF_JSON.$$" "$CONF_JSON" &&
			printf '%s\n' "$W_RKEY" | md5sum >"$RESTART_KEY"
	) || {
		rm -f "$CONF_JSON.$$"
		log err "cannot write $CONF_JSON"
		return 1
	}
	return 0
}

weaver_exclude() {
	list_has "$W_EXCLUDE" "$1" || W_EXCLUDE="$W_EXCLUDE $1"
}

# weaver_fw_set SID OPTION VALUE
weaver_fw_set() {
	[ "$(uci -q get "firewall.$1.$2")" = "$3" ] && return 0
	uci -q set "firewall.$1.$2=$3" && W_FW_CHANGED=1
}

# Open udp/listen_port from wan for a running server; close it otherwise.
# The firewall is only reloaded when the rule actually changed.
weaver_firewall() {
	local open="$1" port="$2" sid

	[ -f /etc/config/firewall ] || return 0
	W_FW_CHANGED=0
	sid=$(uci -q -X show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='$FW_RULE'\$/\1/p" | head -n 1)
	if [ -z "$sid" ]; then
		[ "$open" = 1 ] || return 0
		sid=$(uci -q add firewall rule) || return 0
		uci -q set "firewall.$sid.name=$FW_RULE"
		W_FW_CHANGED=1
	fi
	if [ "$open" = 1 ]; then
		weaver_fw_set "$sid" src wan
		weaver_fw_set "$sid" proto udp
		weaver_fw_set "$sid" dest_port "$port"
		weaver_fw_set "$sid" target ACCEPT
		weaver_fw_set "$sid" enabled 1
	else
		weaver_fw_set "$sid" enabled 0
	fi
	[ "$W_FW_CHANGED" = 1 ] || return 0

	uci -q commit firewall
	if [ "$open" = 1 ]; then
		log info "firewall: $FW_RULE opened (udp/$port from wan)"
	else
		log info "firewall: $FW_RULE closed"
	fi
	[ -x /etc/init.d/firewall ] && /etc/init.d/firewall reload >/dev/null 2>&1
	return 0
}

start_service() {
	local rc=0

	# shellcheck source=/dev/null
	. /lib/functions/network.sh
	weaver_generate || rc=$?
	weaver_firewall "$W_OPEN" "$W_PORT"
	if [ "$rc" != 0 ]; then
		# Disabled, waiting or broken: no instance, so procd stops a running
		# one, and no private key left lying in /var/run.
		rm -f "$CONF_JSON" "$RESTART_KEY"
		[ "$rc" = 1 ] && return 1
		return 0
	fi

	procd_open_instance main
	procd_set_param command "$PROG" run -c "$CONF_JSON"
	procd_set_param file "$RESTART_KEY"
	# Never give up: a restart-needing change the daemon spots on SIGHUP makes
	# it exit for procd to start it again, and those must not count against a
	# crash limit.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	local before after

	before=$(cat "$RESTART_KEY" 2>/dev/null)
	start
	after=$(cat "$RESTART_KEY" 2>/dev/null)
	# Same restart key: the daemon is the one that was running, so it re-reads
	# the new file on SIGHUP. A different key means procd has just restarted it
	# with the new file already.
	if [ -n "$after" ] && [ "$before" = "$after" ] && procd_running weaver main; then
		procd_send_signal weaver main HUP
	fi
}

service_triggers() {
	procd_add_reload_trigger weaver
}

genconf() {
	local rc=0

	# shellcheck source=/dev/null
	. /lib/functions/network.sh
	weaver_generate force || rc=$?
	[ "$rc" = 0 ] && echo "$CONF_JSON"
	return "$rc"
}

# Stopping leaves the rule alone (a reboot or restart would otherwise reload
# the firewall twice); removing the package must not leave the port open.
closefw() {
	weaver_firewall 0 ""
}
